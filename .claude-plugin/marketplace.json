{
  "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
  "name": "trackmind",
  "owner": { "name": "Trackmind", "email": "oss@trackmind.com" },
  "description": "Trackmind's open-source Claude Code plugins.",
  "plugins": [
    {
      "name": "mcp-rubriq",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/trackmind-ai/mcp-rubriq.git",
        "path": "plugins/mcp-rubriq",
        "ref": "main"
      },
      "description": "Grades MCP (Model Context Protocol) servers against a published 28-rule quality rubric.",
      "author": { "name": "Trackmind", "email": "oss@trackmind.com" },
      "homepage": "https://github.com/trackmind-ai/mcp-rubriq",
      "repository": "https://github.com/trackmind-ai/mcp-rubriq",
      "license": "MIT",
      "category": "quality",
      "keywords": ["mcp", "rubric", "linter", "model-context-protocol", "quality", "security"]
    },
    {
      "name": "automaqa",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/trackmind-ai/automa-qa.git",
        "path": "plugins/automaqa",
        "ref": "main"
      },
      "description": "Installs and verifies a complete E2E toolchain (Playwright for web, Maestro for mobile), then drives spec-driven test authoring, live verification, and versioned HTML reporting.",
      "author": { "name": "Trackmind", "email": "oss@trackmind.com" },
      "homepage": "https://github.com/trackmind-ai/automa-qa",
      "repository": "https://github.com/trackmind-ai/automa-qa",
      "license": "MIT",
      "category": "testing",
      "keywords": ["playwright", "maestro", "e2e", "testing", "automation", "mobile", "web", "qa"]
    },
        {
      "name": "sdlc-atlas",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/trackmind-ai/sdlc-atlas.git",
        "path": "plugins/sdlc-atlas",
        "ref": "main"
      },
      "description": "Agent-driven SDLC platform. Takes a requirement to production-ready code through governed pipelines: versioned specs, approval gates, and ordered quality gates across a four-layer capability model (platform, stacks, organization, project).",
      "author": { "name": "Trackmind", "email": "oss@trackmind.com" },
      "homepage": "https://github.com/trackmind-ai/sdlc-atlas",
      "repository": "https://github.com/trackmind-ai/sdlc-atlas",
      "license": "MIT",
      "category": "development",
      "keywords": ["sdlc", "agents", "pipeline", "quality-gates", "specifications", "code-review", "scaffolding"]
    },
    {
      "name": "spec-security-review",
      "source": {
        "source": "url",
        "url": "https://github.com/trackmind-ai/security-review-speckit.git",
        "ref": "main"
      },
      "description": "Structured, evidence-based security reviews: SAST, SCA, authorization, XSS, supply-chain and AI/LLM tracks, with exact files, lines, impact and remediation. Read-only by default.",
      "author": { "name": "Trackmind", "email": "oss@trackmind.com" },
      "homepage": "https://github.com/trackmind-ai/security-review-speckit",
      "repository": "https://github.com/trackmind-ai/security-review-speckit",
      "license": "MIT",
      "category": "security",
      "keywords": ["security", "sast", "sca", "owasp", "code-review", "xss", "supply-chain", "llm-security"]
    }
  ],
  "renames": {
    "mcplint": "mcp-rubriq"
  }
}
